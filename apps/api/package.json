{
  "name": "@animaps/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "prisma:generate": "dotenv -e .env -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e .env -e ../../.env -- prisma migrate dev",
    "prisma:studio": "dotenv -e .env -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/express": "^5.0.3",
    "@types/node": "^20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "prisma": "^6.16.1",
    "typescript": "^5",
    "typescript-eslint": "^8.44.0"
  }
}
