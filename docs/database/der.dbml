  mobile_ios
  mobile_android
  unknown
}

Enum push_platform {
  ios
  android
}

Enum notification_type {
  user_registered
  organization_verified
  veterinary_verified
  adoption_requested
  adoption_completed
  animal_registered_for_matching
  new_compatible_animal_available
  occurrence_created
  occurrence_status_changed
  occurrence_resolved
  generic
}

Enum audit_action {
  organization_verified
  veterinary_verified
  user_type_changed
  account_deleted
  data_exported
  occurrence_validated
  institution_verified
  institution_suspended
  case_created
  case_status_changed
  case_assigned
  case_routed
  role_granted
  membership_changed
}

Enum occurrence_report_reason {
  spam
  duplicate
  false_information
  inappropriate_content
}

Enum user_intention_kind {
  adopt
  pet_owner
  help_animals
  report
  lost_animal
  found_animal
  community
  explore
  volunteer
  foster_home
  independent_protector
  animal_professional
  lost_pet_owner
  found_pet_reporter
  other
}

Enum location_permission {
  granted
  denied
  not_requested
}

Enum verification_kind {
  selfie
  institutional
}

Enum verification_status {
  pending
  processing
  approved
  rejected
  retry_required
}

Enum privacy_visibility {
  public
  matches
  private
}

Enum auth_provider {
  google
}

Enum account_type {
  person
  organization
  institution
}

Enum organization_type {
  ngo
  animal_shelter
  veterinary_clinic
  veterinary_hospital
  animal_business
  animal_service
  private_institution
  other
}

Enum institution_verification_status {
  draft
  pending_verification
  under_review
  approved
  rejected
  suspended
}

Enum jurisdiction_type {
  national
  state
  municipal
  regional
  local
}

Enum role_scope {
  platform
  organization
  institution
}

Enum membership_status {
  invited
  active
  suspended
  left
}

Enum case_source {
  citizen
  ngo
  veterinary
  institution
  system
  import
  api
  partner
}

Enum case_status {
  new
  triage
  under_review
  assigned
  in_progress
  waiting_information
  resolved
  closed
  cancelled
  duplicate
  invalid
}

Enum case_citizen_status {
  registered_on_platform
  awaiting_routing
