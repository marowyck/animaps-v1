  received
  under_analysis
  in_progress
  resolved
}

Enum case_priority {
  low
  medium
  high
  critical
}

Enum location_precision {
  exact
  approximate
  city
  region
  hidden
}

Enum data_classification {
  public
  internal
  restricted
  confidential
  sensitive
}

Enum reporter_visibility {
  public
  restricted
  confidential
  anonymous
}

Enum case_comment_visibility {
  internal
  public
}

Enum case_participant_role {
  reporter
  assignee
  observer
  routed_institution
  origin_organization
  responder
}

Enum case_routing_reason {
  initial
  no_competence
  out_of_region
  out_of_type
  partnership
  specialization
  other
}

Enum integration_sync_status {
  pending
  syncing
  success
  failed
  retrying
  disabled
}

Table users {
  id uuid [pk]
  name varchar [not null]
  email varchar [unique, not null]
  username varchar [unique, note: 'Optional public handle']
  password_hash varchar [note: 'Email/password hash. Nullable for Google/OAuth — app rule: hash OR auth_identities row. Never plaintext.']
  user_type user_type [not null]
  account_type account_type [note: 'Nullable until ecosystem cutover; derive from user_type when unset']
  avatar_url varchar
  status account_status [not null, default: 'active']
  phone varchar
  city varchar
  state varchar
  lgpd_consent boolean [not null, default: false]
  lgpd_consent_at timestamp
  privacy_policy_version varchar [note: 'Policy slug accepted at consent (e.g. v1-draft)']
  guidelines_accepted_at timestamp
  email_verified_at timestamp
  deleted_at timestamp [note: 'Soft delete / LGPD erasure readiness']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    deleted_at
    account_type
  }
}

Table person_profiles {
  user_id uuid [pk, ref: - users.id]
  available_space available_space
  available_time available_time
  has_previous_experience boolean [not null, default: false]
  has_other_pets boolean [not null, default: false]
  preferred_size preferred_size [note: 'Narrow hint; source of truth is animal_preferences']
  preferred_species preferred_species
  is_rescuer boolean [not null, default: false, note: 'Allows person to register animals. Not collected in current onboarding.']
  tax_id varchar [note: 'Individual tax id (e.g. CPF in BR)']
  updated_at timestamp [not null]
}

Table organization_profiles {
  user_id uuid [pk, ref: - users.id]
  company_tax_id varchar [note: 'Nullable on first persist; required before verified=true']
  trade_name varchar [not null]
  description text
  phone varchar
  email varchar
  website varchar
  social_links jsonb
  city varchar
  state varchar
  area_of_operation varchar [note: 'Free-text from onboarding areaOfOperation']
  animal_types_served "varchar[]" [default: '{}']
  has_shelter boolean [not null, default: false]
  does_adoptions boolean [not null, default: false]
  does_rescues boolean [not null, default: false]
  accepts_volunteers boolean [not null, default: false]
  accepts_donations boolean [not null, default: false]
  service_area_radius_km decimal [note: 'PostGIS polygon later; radius is MVP']
  service_capacity int
  verified boolean [not null, default: false]
  updated_at timestamp [not null]
}

Table veterinary_profiles {
  user_id uuid [pk, ref: - users.id]
  company_tax_id varchar [note: 'Nullable on first persist; required before verified=true']
  trade_name varchar
  description text
  phone varchar
  email varchar
  website varchar
  address text
  services_offered "varchar[]" [note: 'vaccination, neutering, emergency_care, grooming']
  business_hours text
  is_24h boolean [not null, default: false]
  emergency_care boolean [not null, default: false]
  home_service boolean [not null, default: false]
  animals_served "varchar[]" [default: '{}']
  verified boolean [not null, default: false, note: 'Manual validation - same as organization']
  updated_at timestamp [not null]
}

Table other_profiles {
  user_id uuid [pk, ref: - users.id]
  other_role other_role
  notes text
  updated_at timestamp [not null]
}

Table user_intentions {
  user_id uuid [not null, ref: > users.id]
  intention user_intention_kind [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, intention) [pk]
  }
}

Table interests {
  id varchar [pk, note: 'Slug matching frontend INTEREST_CATALOG']
  sort_order int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
}

Table user_interests {
  user_id uuid [not null, ref: > users.id]
  interest_id varchar [not null, ref: > interests.id]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, interest_id) [pk]
  }
}

Table animal_preferences {
  user_id uuid [pk, ref: - users.id]
  species "varchar[]" [default: '{}']
  sizes "varchar[]" [default: '{}']
  ages "varchar[]" [default: '{}']
  sex "varchar[]" [default: '{}']
  vaccination "varchar[]" [default: '{}']
  neutered "varchar[]" [default: '{}']
  special_needs "varchar[]" [default: '{}']
  compatibility "varchar[]" [default: '{}']
  energy_level "varchar[]" [default: '{}']
  environment "varchar[]" [default: '{}']
  updated_at timestamp [not null]
}

Table verification_requests {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  kind verification_kind [not null]
  status verification_status [not null, default: 'pending']
  provider varchar
  provider_ref varchar
  media_url text [note: 'Private short-lived URL; not a biometric template']
  rejection_reason varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (user_id, kind, created_at)
  }
}

Table user_locations {
  user_id uuid [pk, ref: - users.id]
  permission location_permission [not null, default: 'not_requested']
  city varchar
  state varchar
  neighborhood varchar
  approx_latitude decimal [note: 'Rounded in app before persist']
  approx_longitude decimal
  updated_at timestamp [not null]
}

Table user_profile_fields {
  user_id uuid [not null, ref: > users.id]
  field_key varchar [not null, note: 'e.g. animal_experience, housing_type']
  value varchar
  visibility privacy_visibility [not null, default: 'private']
  updated_at timestamp [not null]

  indexes {
    (user_id, field_key) [pk]
  }
}

Table auth_identities {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  provider auth_provider [not null]
  provider_subject varchar [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (provider, provider_subject) [unique]
    user_id
  }
}

Table notification_preferences {
  user_id uuid [pk, ref: - users.id]
  in_app boolean [not null, default: true]
  email boolean [not null, default: true]
  push boolean [not null, default: false]
  updated_at timestamp [not null]
}

Table animals {
  id uuid [pk]
  organization_id uuid [ref: > users.id, note: 'Organization owner user id when applicable']
  person_id uuid [ref: > users.id, note: 'Rescuer person when applicable']
  veterinary_id uuid [ref: > users.id, note: 'Veterinary clinic that registered when applicable']
  name varchar [not null]
  species animal_species [not null]
  breed varchar
  estimated_age varchar
  size animal_size
  temperament "varchar[]" [note: 'docile, playful, independent, needs_space, ...']
  health_history text
  photos "text[]" [note: 'MVP object-storage URLs; MediaAsset later']
  status animal_status [not null, default: 'available']
  deleted_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    status
    (species, size)
    deleted_at
  }
}

Table animal_favorites {
  user_id uuid [not null, ref: > users.id]
  animal_id uuid [not null, ref: > animals.id]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, animal_id) [pk]
    animal_id
  }
}

Table adoptions {
  id uuid [pk]
  animal_id uuid [not null, ref: > animals.id]
  person_id uuid [not null, ref: > users.id]
  organization_id uuid [ref: > users.id, note: 'Origin organization when applicable']
  compatibility_score decimal [note: '0-100 at request time']
  status adoption_status [not null, default: 'requested']
  requested_at timestamp [not null, default: `now()`]
  completed_at timestamp
  updated_at timestamp [not null]

  indexes {
    (animal_id, person_id) [unique]
    (animal_id, status)
    person_id
  }
}

Table occurrences {
  id uuid [pk]
  user_id uuid [ref: > users.id, note: 'Nullable = anonymous report']
  type occurrence_type [not null]
  description text
  location geography [not null, note: 'PostGIS geography(Point, 4326); GIST index via raw SQL']
  city varchar [note: 'Denormalized for LGPD-safe aggregates']
  neighborhood varchar
  photos "text[]"
  status occurrence_status [not null, default: 'open']
  validated_by uuid [ref: > users.id, note: 'Organization or public_agency user id']
  claim_token_hash varchar [unique, note: 'Hash only; plaintext returned once to anonymous reporter']
  geo_consent_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (status, type)
    created_at
    (city, neighborhood)
  }
}

Table occurrence_followers {
  occurrence_id uuid [not null, ref: > occurrences.id]
  user_id uuid [not null, ref: > users.id, note: 'Organization / public_agency / biologist following the case']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (occurrence_id, user_id) [pk]
  }
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  type notification_type [not null]
  message text [not null]
  payload jsonb [note: 'Forward-compatible event data']
  "read" boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (user_id, "read", created_at)
  }
}

Table refresh_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  token_hash varchar [unique, not null, note: 'Hash only - never plaintext']
  client_type client_type [not null, default: 'unknown']
  device_id varchar
  user_agent varchar
  revoked_at timestamp
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    user_id
    device_id
  }
}

Table email_verification_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  token_hash varchar [unique, not null]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    user_id
  }
}

Table password_reset_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  token_hash varchar [unique, not null]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    user_id
  }
}

Table device_push_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  platform push_platform [not null]
  token varchar [unique, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  last_seen_at timestamp [not null, default: `now()`]

  indexes {
    user_id
  }
}

Table waitlist_entries {
  id uuid [pk]
  name varchar [not null]
  email varchar [unique, not null]
  profile_type waitlist_profile_type [not null]
  city varchar
  state varchar
  lgpd_consent_at timestamp [not null]
  privacy_policy_version varchar
  converted_user_id uuid [unique, ref: - users.id, note: 'Set when identity RegisterUser consumes this lead']
  created_at timestamp [not null, default: `now()`]

  Note: '/register step 1 lead only. Do NOT store passwords here — credentials go to users.password_hash when auth ships.'

  indexes {
    created_at
  }
}

Table audit_logs {
  id uuid [pk]
  actor_id uuid [ref: > users.id, note: 'Nullable for system actions']
  action audit_action [not null]
  target_type varchar [note: 'e.g. user, occurrence, animal']
  target_id uuid
  metadata jsonb [note: 'Avoid secrets or full PII payloads']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (actor_id, created_at)
  }
}

Table occurrence_reports {
  id uuid [pk]
  occurrence_id uuid [not null, ref: > occurrences.id]
  reported_by uuid [ref: > users.id, note: 'Nullable if anonymous']
  reason occurrence_report_reason [not null]
  notes text
  created_at timestamp [not null, default: `now()`]

  indexes {
    occurrence_id
  }
}

// Ecosystem layer (Fase 1 foundation) — additive; see docs/overview.md
// Case supersedes Occurrence for institutional flows; Occurrence kept for Wave 2 map.

Table organizations {
  id uuid [pk]
  owner_user_id uuid [ref: > users.id, note: 'Creating user (owner); memberships hold the team']
  organization_type organization_type [not null]
  trade_name varchar [not null]
  legal_name varchar
  description text
  company_tax_id varchar
  email varchar
  phone varchar
  website varchar
  social_links jsonb
  city varchar
  state varchar
  country varchar [default: 'BR']
  verified boolean [not null, default: false]
  deleted_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    organization_type
    verified
  }
}

Table organization_members {
  id uuid [pk]
  organization_id uuid [not null, ref: > organizations.id]
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]
  status membership_status [not null, default: 'active']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (organization_id, user_id) [unique]
    user_id
  }
}

Table institution_types {
  id varchar [pk, note: 'Lookup-backed institution kinds — add rows, not enum migrations']
  label_key varchar [not null]
  sort_order int [not null, default: 0]
  active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table institutions {
  id uuid [pk]
  institution_type_id varchar [not null, ref: > institution_types.id]
  official_name varchar [not null]
  public_name varchar [not null]
  description text
  city varchar
  state varchar
  country varchar [default: 'BR']
  email varchar
  email_domain varchar
  phone varchar
  website varchar
  social_links jsonb
  address varchar
  responsible_department varchar
  data_responsible_area varchar
  verification_status institution_verification_status [not null, default: 'draft']
  verified_at timestamp
  deleted_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    institution_type_id
    verification_status
  }
}

Table institution_departments {
  id uuid [pk]
  institution_id uuid [not null, ref: > institutions.id]
  parent_department_id uuid [ref: > institution_departments.id]
  name varchar [not null]
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    institution_id
  }
}

Table institution_teams {
  id uuid [pk]
  institution_id uuid [not null, ref: > institutions.id]
  department_id uuid [ref: > institution_departments.id]
  name varchar [not null]
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    institution_id
  }
}

Table institution_members {
  id uuid [pk]
  institution_id uuid [not null, ref: > institutions.id]
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]
  department_id uuid [ref: > institution_departments.id]
  team_id uuid [ref: > institution_teams.id]
  status membership_status [not null, default: 'active']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (institution_id, user_id) [unique]
    user_id
  }
}

Table institution_jurisdictions {
  id uuid [pk]
  institution_id uuid [not null, ref: > institutions.id]
  jurisdiction_type jurisdiction_type [not null]
  value varchar [not null, note: 'Free-text or code (city name, IBGE code, state UF, etc.)']
  country varchar [default: 'BR']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (institution_id, jurisdiction_type)
    value
  }
}

Table institution_capabilities {
  id uuid [pk]
  institution_id uuid [not null, ref: > institutions.id]
  case_type_id varchar [not null, ref: > case_types.id]
  accepts boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (institution_id, case_type_id) [unique]
  }
}

Table institution_report_policies {
  institution_id uuid [pk, ref: - institutions.id]
  anonymous_reports boolean [not null, default: true]
  required_fields jsonb
  accepted_case_type_ids "varchar[]" [default: '{}']
  routing_rules jsonb
  response_visibility varchar
  updated_at timestamp [not null]
}

Table roles {
  id uuid [pk]
  "key" varchar [unique, not null, note: 'Stable key e.g. INSTITUTION_ADMIN, ORGANIZATION_MEMBER']
  scope role_scope [not null]
  description text
  created_at timestamp [not null, default: `now()`]

  indexes {
    scope
  }
}

Table permissions {
  id uuid [pk]
  "key" varchar [unique, not null, note: 'Stable key e.g. VIEW_INCOMING_REPORTS, CREATE_ANIMAL']
  domain varchar [not null]
  description text
  created_at timestamp [not null, default: `now()`]

  indexes {
    domain
  }
}

Table role_permissions {
  role_id uuid [not null, ref: > roles.id]
  permission_id uuid [not null, ref: > permissions.id]

  indexes {
    (role_id, permission_id) [pk]
  }
}

Table user_platform_roles {
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, role_id) [pk]
  }
}

Table locations {
  id uuid [pk]
  latitude decimal [note: 'Optional precise point — prefer approx + city for public surfaces']
  longitude decimal
  city varchar
  state varchar
  country varchar [default: 'BR']
  neighborhood varchar
  postal_code varchar
  formatted_address varchar
  precision location_precision [not null, default: 'approximate']
  privacy_level data_classification [not null, default: 'restricted']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (city, state)
  }
}

Table case_types {
  id varchar [pk]
  label_key varchar [not null]
  sort_order int [not null, default: 0]
  active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table cases {
  id uuid [pk]
  reference_number varchar [unique, not null]
  case_type_id varchar [not null, ref: > case_types.id]
  status case_status [not null, default: 'new']
  citizen_status case_citizen_status [not null, default: 'registered_on_platform']
  priority case_priority [not null, default: 'medium']
  source case_source [not null]
  title varchar
  description text
  location_id uuid [ref: > locations.id]
  reporter_id uuid [ref: > users.id]
  organization_id uuid [ref: > organizations.id]
  institution_id uuid [ref: > institutions.id]
  assigned_user_id uuid [ref: > users.id]
  assigned_team_id uuid [ref: > institution_teams.id]
  reporter_visibility reporter_visibility [not null, default: 'restricted']
  classification data_classification [not null, default: 'internal']
  occurrence_id uuid [ref: > occurrences.id, note: 'Optional Wave 2 link until expand-contract']
  claim_token_hash varchar [unique, note: 'Hash only for anonymous claim (mirrors occurrences.claim_token_hash)']
  geo_consent_at timestamp
  closed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  Note: 'Central work item — denunciations, lost/found, help requests, risk situations. Supersedes Occurrence for institutional routing; Occurrence remains for legacy map MVP.'

  indexes {
    (status, priority)
    citizen_status
    case_type_id
    (institution_id, status)
    created_at
  }
}

Table case_status_history {
  id uuid [pk]
  case_id uuid [not null, ref: > cases.id]
  from_status case_status
  to_status case_status [not null]
  from_citizen_status case_citizen_status
  to_citizen_status case_citizen_status
  actor_id uuid [ref: > users.id]
  "note" text
  created_at timestamp [not null, default: `now()`]

  indexes {
    (case_id, created_at)
  }
}

Table case_assignments {
  id uuid [pk]
  case_id uuid [not null, ref: > cases.id]
  user_id uuid [ref: > users.id]
  team_id uuid [ref: > institution_teams.id]
  assigned_by uuid [ref: > users.id]
  "note" text
  created_at timestamp [not null, default: `now()`]
  ended_at timestamp

  indexes {
    (case_id, created_at)
  }
}

Table case_routing {
  id uuid [pk]
  case_id uuid [not null, ref: > cases.id]
  from_institution_id uuid [ref: > institutions.id]
  to_institution_id uuid [ref: > institutions.id]
  reason case_routing_reason [not null, default: 'initial']
  "note" text
  created_at timestamp [not null, default: `now()`]

  indexes {
    (case_id, created_at)
  }
}

Table case_comments {
  id uuid [pk]
  case_id uuid [not null, ref: > cases.id]
  author_id uuid [ref: > users.id]
  body text [not null]
  visibility case_comment_visibility [not null, default: 'internal']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (case_id, created_at)
  }
}

Table case_attachments {
  id uuid [pk]
  case_id uuid [not null, ref: > cases.id]
  url varchar [not null]
  mime_type varchar
  kind varchar [default: 'photo']
  created_at timestamp [not null, default: `now()`]

  indexes {
    case_id
  }
}

Table case_participants {
  id uuid [pk]
  case_id uuid [not null, ref: > cases.id]
  user_id uuid [ref: > users.id]
  role case_participant_role [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    case_id
  }
}

Table data_exports {
  id uuid [pk]
  requested_by_id uuid [ref: > users.id]
  institution_id uuid [ref: > institutions.id]
  format varchar [not null]
  purpose varchar
  filters jsonb
  created_at timestamp [not null, default: `now()`]

  indexes {
    created_at
  }
}

Table integration_connections {
  id uuid [pk]
  institution_id uuid [ref: > institutions.id]
  name varchar [not null]
  provider varchar
  status integration_sync_status [not null, default: 'pending']
  config jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
}

Table integration_logs {
  id uuid [pk]
  connection_id uuid [not null, ref: > integration_connections.id]
  status integration_sync_status [not null]
  message text
  payload jsonb
  created_at timestamp [not null, default: `now()`]

  indexes {
    (connection_id, created_at)
  }
}

TableGroup identity {
  users
  person_profiles
  organization_profiles
  veterinary_profiles
  other_profiles
  user_intentions
  interests
  user_interests
  animal_preferences
  verification_requests
  user_locations
  user_profile_fields
  auth_identities
  refresh_tokens
  email_verification_tokens
  password_reset_tokens
  device_push_tokens
  notification_preferences
}

TableGroup adoption {
  animals
  adoptions
  animal_favorites
}

TableGroup occurrence {
  occurrences
  occurrence_followers
  occurrence_reports
}

TableGroup notifications {
  notifications
}

TableGroup marketing {
  waitlist_entries
}

TableGroup audit {
  audit_logs
}

TableGroup organization {
  organizations
  organization_members
}

TableGroup institution {
  institution_types
  institutions
  institution_departments
  institution_teams
  institution_members
  institution_jurisdictions
  institution_capabilities
  institution_report_policies
}

TableGroup rbac {
  roles
  permissions
  role_permissions
  user_platform_roles
}

TableGroup cases {
  locations
  case_types
  cases
  case_status_history
  case_assignments
  case_routing
  case_comments
  case_attachments
  case_participants
  data_exports
}

TableGroup integrations {
  integration_connections
  integration_logs
}
