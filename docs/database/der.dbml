// ANIMAPS — ER diagram for https://dbdiagram.io
// Paste THIS file (docs/der.dbml) into dbdiagram.io — NOT schema.prisma
// Keep in sync with schema.prisma — see schema-evolution.md

Project animaps {
  database_type: 'PostgreSQL'
  Note: 'Responsible adoption + georeferenced animal occurrences. UserType on users; type-specific 1:1 profiles. /register is two-step UI: waitlist_entries stores the lead only; password hashes belong on users.password_hash when identity auth ships (never on waitlist). Wave 2 identity tables: user_intentions, interests, animal_preferences, verification_requests, user_locations, user_profile_fields, auth_identities. Ecosystem layer (Fase 1, additive): nullable account_type on users; organizations and institutions; RBAC; Case (supersedes Occurrence for institutional flows); routing; integrations.'
}

Enum user_type {
  person
  ong
  veterinary_clinic
  other
  public_agency
  biologist
}

Enum account_status {
  active
  pending_verification
  suspended
}

Enum other_role {
  independent_protector
  foster_home
  volunteer
  animal_professional
  animal_business
  community_member
  other
}

Enum available_space {
  small_apartment
  large_apartment
  house_with_yard
  farm
}

Enum available_time {
  low
  moderate
  high
}

Enum preferred_size {
  small
  medium
  large
  any
}

Enum preferred_species {
  dog
  cat
  other
  any
}

Enum animal_species {
  dog
  cat
  other
}

Enum animal_size {
  small
  medium
  large
}

Enum animal_status {
  available
  in_process
  adopted
}

Enum adoption_status {
  requested
  under_review
  approved
  rejected
  completed
  cancelled
}

Enum occurrence_type {
  abandonment
  mistreatment
  vehicle_collision
  wildlife_sighting
  lost_animal
  found_animal
}

Enum occurrence_status {
  open
  in_progress
  resolved
  invalid
}

Enum waitlist_profile_type {
  person
  ong
  veterinary_clinic
  other
  institution
}

Enum client_type {
